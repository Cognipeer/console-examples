# Console base URL (no trailing slash, no /api/client/v1)
CONSOLE_BASE_URL=https://console.cognipeer.com
# API token (Settings -> API Tokens). It needs access to the MCP service.
CONSOLE_API_KEY=cpeer_replace_me

# register-openapi.ts creates a server with this key (optional, derived from the name otherwise)
MCP_SERVER_KEY=weather-demo

# mcp-client.ts: which server to connect to, and which tool to call
# (leave MCP_TOOL empty to just list tools; use MCP_SERVER_KEY=console for the built-in Console server)
MCP_TOOL=
MCP_TOOL_ARGS={}
# sse (documented, default) or streamable-http
MCP_TRANSPORT=sse
