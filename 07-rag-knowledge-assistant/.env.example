# Console base URL (no trailing slash, no /api/client/v1)
CONSOLE_BASE_URL=https://console.cognipeer.com
# API token (Settings -> API Tokens) with access to Vector, Knowledge Engine and Agents
CONSOLE_API_KEY=cpeer_replace_me

# Created beforehand in the Console UI (see README "Console setup")
VECTOR_PROVIDER_KEY=your-vector-provider-key
EMBEDDING_MODEL_KEY=your-embedding-model-key
CHAT_MODEL_KEY=your-chat-model-key
# Output dimension of the embedding model (e.g. 1536 for text-embedding-3-small)
EMBEDDING_DIMENSION=1536

# Optional overrides
RAG_MODULE_KEY=handbook-demo
AGENT_NAME=Handbook assistant
