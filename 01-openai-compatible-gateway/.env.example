# Base URL of your Console deployment, WITHOUT the /api/client/v1 suffix.
CONSOLE_BASE_URL=https://your-console.example.com
# API token created in the dashboard (API Tokens page). Used as the OpenAI "apiKey".
CONSOLE_API_TOKEN=replace-with-your-api-token
# Model KEY (not the provider model id) of a chat model in your project.
CONSOLE_CHAT_MODEL=my-chat-model
# Model KEY of an embedding model (only for embeddings.ts).
CONSOLE_EMBEDDING_MODEL=my-embedding-model
