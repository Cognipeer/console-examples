# Base URL of your Console, WITHOUT the /api/client/v1 suffix.
CONSOLE_BASE_URL=https://console.cognipeer.com
# Console API token (Settings > API Tokens). Starts with cpeer_
CONSOLE_API_TOKEN=cpeer_replace_me
# Key of the agent that has additional models configured.
AGENT_KEY=my-agent
# A model key that is NOT offered by the agent (used to demo model_not_allowed).
FORBIDDEN_MODEL_KEY=some-model-the-agent-does-not-offer
