# Leave the three CONSOLE_* values empty to run the offline demo agent.
# Fill in all three to front a Console agent instead.

# Console origin, WITHOUT /api/client/v1 (for example https://your-console.example.com)
CONSOLE_BASE_URL=
# Console API token (Settings > API Tokens), starts with cpeer_. Server-side only, never sent to the browser.
CONSOLE_API_TOKEN=
# Key of a published Console agent that has additional models.
CONSOLE_AGENT_KEY=
