# Console API token with the "tracing" service enabled (Settings -> API Tokens)
COGNIPEER_API_KEY=cpeer_replace_me
# Your Console base URL, no trailing slash and no /api/client/v1 suffix
COGNIPEER_BASE_URL=https://console.cognipeer.com

# Only for the LangChain example: the model key to call through the Console gateway
CONSOLE_MODEL_KEY=your-model-key
