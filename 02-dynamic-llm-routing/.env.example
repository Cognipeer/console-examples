# Console origin, WITHOUT the /api/client/v1 suffix.
CONSOLE_BASE_URL=https://your-console.example.com
# API token (OpenAI "apiKey"). create-model.ts needs write access to Models.
CONSOLE_API_TOKEN=replace-with-your-api-token
# Key of the Dynamic LLM you created (route.ts sends requests to it).
CONSOLE_DYNAMIC_MODEL=smart-router
