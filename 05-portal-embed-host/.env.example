# Console origin that serves the widget script and the chat frame.
CONSOLE_URL=https://console.example.com

# Your workspace slug (the Embed tab prints it in every snippet) and the portal's key.
COGNIPEER_TENANT=acme
COGNIPEER_PORTAL=support

# From Operate > Portals > your portal > Embed > Token signing (HS256).
# EMBED_ISSUER must equal the Issuer field EXACTLY (a trailing slash counts).
EMBED_ISSUER=http://localhost:3000
EMBED_KEY_ID=sec_replace_me
EMBED_SECRET=cps_replace_me

# Optional: set to true only if the portal has "Require the workspace in the audience" on.
# Then aud becomes cognipeer-portal:<tenant>:<portal>.
EMBED_REQUIRE_WORKSPACE_AUD=false

PORT=3000
