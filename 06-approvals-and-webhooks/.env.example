# Console origin (no trailing path). The SDK adds /api/client/v1 itself.
CONSOLE_URL=https://console.example.com

# Project API token (Settings -> API Tokens). Its owner must be allowed to answer
# approvals under the agent's "Who can answer" setting (tenant/project admin by default).
COGNIPEER_API_TOKEN=cp_replace_me

# Signing secret shown ONCE when you create the webhook (whsec_...).
COGNIPEER_WEBHOOK_SECRET=whsec_replace_me

# Key of the agent that needs approval (used by start-run.ts).
AGENT_KEY=ops-agent

# Receiver port.
PORT=4000

# Approval policy of this demo receiver: comma-separated substrings.
# A tool call whose JSON arguments contain one of them is DENIED, everything else is allowed.
DENY_PATTERNS=rm -rf /,DROP TABLE
